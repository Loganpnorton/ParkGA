# ═══════════════════════════════════════════════════════════════════════════
# ParkGA — Environment Variable Reference
# Copy this file to .env.local and fill in your values before running.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=             # Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Project anon (public) key from Supabase Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=            # Service role key (secret!) for admin server-side operations (cron jobs, webhooks)

# ── Mapbox ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=             # Public Mapbox access token for maps on listing/search pages

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                    # Stripe secret key (sk_test_... or sk_live_...) for API calls
STRIPE_WEBHOOK_SECRET=                # Stripe webhook signing secret (whsec_...) for verifying webhook events
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Stripe publishable key (pk_test_... or pk_live_...) for client-side Checkout
NEXT_PUBLIC_SITE_URL=                 # Canonical site URL (https://parkga.com in production, http://localhost:3000 for dev)

# ── Twilio (SMS Notifications) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=                   # Twilio Account SID (AC...) from Twilio Console
TWILIO_AUTH_TOKEN=                    # Twilio Auth Token (secret!) from Twilio Console
TWILIO_PHONE_NUMBER=                  # Twilio phone number (e.g. +17372583742) for sending SMS
# TWILIO_MESSAGING_SERVICE_SID=       # Optional: Messaging Service SID (MG...) if using a Messaging Service instead of a single number